# Скопируйте в docker/env.prod и заполните. Файл не коммитится.
DOMAIN=dnd.example.com
DB_PASSWORD=смените-этот-пароль
JWT_SECRET=минимум-32-символа-случайной-строки-замените
CORS_ORIGINS=https://dnd.example.com
LOG_LEVEL=INFO
# Ключ для выдачи ссылок сброса пароля (заголовок X-Admin-Token).
# Пусто — эндпоинт /api/admin/password-resets отключён.
ADMIN_TOKEN=
WEB_BIND=127.0.0.1
WEB_PORT=8090
SERVER_HEAP_MB=768

