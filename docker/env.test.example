# Скопируйте в docker/env.test и заполните. Файл не коммитится.
DB_PASSWORD=смените-этот-пароль
JWT_SECRET=минимум-32-символа-случайной-строки-замените
PUBLIC_URL=http://адрес-вашего-сервера:8081
CORS_ORIGINS=http://адрес-вашего-сервера:8081,http://localhost:8081
TEST_PORT=8081
LOG_LEVEL=DEBUG

# Внешние входы (необязательно). Пока пусто — кнопки в интерфейсе неактивны.
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
VK_CLIENT_ID=
VK_CLIENT_SECRET=
