# Настройки npm для этого проекта — перекрывают ~/.npmrc и /etc/npmrc.
#
# Зачем: на рабочих машинах npm часто настроен на корпоративное зеркало
# (Nexus/Artifactory), которое знает не все пакеты. Отсюда ошибки вида
# «<пакет> is not in the npm registry». Проектный .npmrc возвращает
# официальный реестр, не трогая общесистемные настройки.
#
# Приоритет у npm: флаги командной строки > переменные окружения > этот файл
# > ~/.npmrc > /etc/npmrc. То есть если реестр подменён переменной
# npm_config_registry, файл не поможет — её нужно снять (см. README).

registry=https://registry.npmjs.org/
strict-ssl=true

# Скоупы из package.json: если в ~/.npmrc им назначен корпоративный реестр,
# здесь возвращаем официальный.
@types:registry=https://registry.npmjs.org/
@vitejs:registry=https://registry.npmjs.org/

# Не мешать сборке: аудит и сбор пожертвований к делу не относятся.
# Vite 6 требует Node 20+: пусть npm скажет это сразу,
# а не падает потом на «node:fs/promises does not provide constants».
engine-strict=true

audit=false
fund=false
