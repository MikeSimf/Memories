<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Сеть: REST API и синхронизация -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Установка скачанного обновления -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Состояние сети: WorkManager с NetworkType.CONNECTED -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Камера: сканирование QR-приглашений -->
    <uses-permission android:name="android.permission.CAMERA" />

    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera.autofocus"
        android:required="false" />

    <application
        android:name=".App"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.DnDMemory">

        <!-- Точка входа: решает, показать вход или список кампаний -->
        <activity
            android:name=".ui.splash.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.DnDMemory">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Вход: только логин и пароль -->
        <activity
            android:name=".ui.auth.AuthActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Сброс пароля: поле почты, ссылку передают администратору -->
        <activity
            android:name=".ui.auth.PasswordResetActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Deep link dndmemory://join?token=... -->
        <activity
            android:name=".ui.invite.InviteAcceptActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:host="join"
                    android:scheme="dndmemory" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.campaigns.CampaignListActivity"
            android:exported="false" />

        <activity
            android:name=".ui.campaign.CampaignActivity"
            android:exported="false" />

        <activity
            android:name=".ui.entity.EntityDetailActivity"
            android:exported="false" />

        <activity
            android:name=".ui.material.MaterialEditActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.entity.EntityEditActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.retelling.RetellingDetailActivity"
            android:exported="false" />

        <activity
            android:name=".ui.retelling.RetellingEditActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.retelling.RetellingListActivity"
            android:exported="false" />

        <activity
            android:name=".ui.entity.HeroListActivity"
            android:exported="false" />

        <activity
            android:name=".ui.material.MaterialsActivity"
            android:exported="false" />

        <activity
            android:name=".ui.members.MembersActivity"
            android:exported="false" />

        <activity
            android:name=".ui.invite.InviteActivity"
            android:exported="false" />

        <activity
            android:name=".ui.invite.ScanActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.search.SearchActivity"
            android:exported="false" />

        <activity
            android:name=".ui.settings.SettingsActivity"
            android:exported="false" />
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
