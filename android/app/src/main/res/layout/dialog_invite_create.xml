<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/invite_create_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/invite_create"
            android:textAppearance="?attr/textAppearanceTitleMedium" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/invite_single_use_hint"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="@color/text_muted" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/invite_create_role_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/invite_role"
            app:endIconMode="dropdown_menu">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/invite_create_role"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/invite_create_linked_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/invite_linked"
            app:endIconMode="dropdown_menu">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/invite_create_linked"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/invite_create_expires_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/invite_expires_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/invite_create_expires"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
