# Скопируйте в .env и заполните. Файл с секретами — не в git.
DB_PASSWORD=придумайте-пароль-для-базы
JWT_SECRET=вставьте-вывод-openssl-rand-base64-48
ADMIN_TOKEN=придумайте-ключ-для-ссылок-сброса-пароля
PUBLIC_URL=https://dnd-memory.imikea.ru/
CORS_ORIGINS=https://dnd-memory.imikea.ru
APP_PORT=8080
SERVER_HEAP_MB=768
LOG_LEVEL=INFO

# Исходящая почта (приём писем не нужен). Без MAIL_ENABLED=true ссылки пишутся в лог.
MAIL_ENABLED=false
MAIL_HOST=smtp.yandex.ru
MAIL_PORT=465
MAIL_SSL=true
MAIL_USERNAME=robot@example.com
MAIL_PASSWORD=пароль-приложения
MAIL_FROM=robot@example.com
# Почта администратора: видит обращения обратной связи
ADMIN_EMAIL=you@example.com

# Служебная учётка system: видит все кампании, не появляется в участниках
SYSTEM_PASSWORD=придумайте-длинный-пароль
